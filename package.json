{
  "name": "@whittakertech/mosaic",
  "author": "WhittakerTech",
  "version": "0.1.0",
  "description": "Event-driven, deterministic drag-and-drop engine with constraint validation and rollback",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/whittakertech/mosaic_js"
  },
  "bugs": {
    "url": "https://github.com/whittakertech/mosaic_js/issues"
  },
  "homepage": "https://mosaicjs.whittakertech.com",
  "scripts": {
    "typecheck": "npm run typecheck:lib && npm run typecheck:test",
    "typecheck:lib": "tsc -p tsconfig.lib.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc",
    "dev": "tsup src/index.ts --format esm --watch",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "release": "npm run build && npm publish --access public"
  },
  "keywords": [
    "drag-drop",
    "ui-engine",
    "state-machine",
    "event-driven",
    "mosaic",
    "whittakertech"
  ],
  "devDependencies": {
    "@nolebase/vitepress-plugin-sidebar": "^2.18.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.15"
  }
}
