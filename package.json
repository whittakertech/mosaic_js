{
  "name": "@whittakertech/mosaic",
  "author": "WhittakerTech",
  "version": "0.1.0",
  "description": "Event-driven drag-and-drop orchestration engine for WhittakerTech Mosaic",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": ".dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "release": "npm publish --access public"
  },
  "keywords": ["drag-drop", "ui-engine", "mosaic", "whittakertech"],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
